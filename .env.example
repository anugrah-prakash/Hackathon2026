# TrustedTokens account key. Never share or commit your completed .env.
TRUSTEDTOKENS_API_KEY=your_trustedtokens_key_here
# Model shown in TrustedTokens docs; change to an exact ID available in your account.
TRUSTEDTOKENS_MODEL=zai-org/GLM-5.3
# Required for camera photos, images and scanned PDFs only.
# Use an image-capable model ID from your TrustedTokens model catalog.
TRUSTEDTOKENS_VISION_MODEL=
